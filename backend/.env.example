APP_NAME=Cross-Asset Sentiment-Driven Systematic Trading Platform API
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crossasset_trading
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
IC_THRESHOLD=0.05
ALLOW_AUTONOMOUS_TRADING=false
REQUIRE_FORWARD_TEST_PASS=true
REQUIRE_DEGRADATION_MONITOR_HEALTH=true
